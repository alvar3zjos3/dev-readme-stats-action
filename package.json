{
  "name": "dev-readme-stats-action",
  "version": "0.3.1",
  "description": "Acción de GitHub para generar tarjetas de estadísticas dinámicas en formato SVG. Bifurcación personalizada con español como idioma principal y temas predeterminados para el ecosistema dev-readme-stats.",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:knip": "knip"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "dev-readme-stats": "https://codeload.github.com/alvar3zjos3/dev-readme-stats/tar.gz/460603e2d5b4774ebc4eff956909d94d73f98151"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,jsonc,yaml,yml}": "prettier --write"
  },
  "engines": {
    "node": "26.x"
  }
}
